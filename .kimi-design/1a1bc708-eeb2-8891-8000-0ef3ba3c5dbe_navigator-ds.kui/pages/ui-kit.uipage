              content: "Типографика, Helvetica Neue"
            }
          - id: ut.type.rows
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 10 }
            children:
              - id: ty.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: row, gap: 24, alignItems: baseline }
                children:
                  - {
                      id: ty.1.s,
                      type: text,
                      size: [ 420, hug ],
                      style: $text.eta,
                      content: Прибытие 14:58
                    }
                  - {
                      id: ty.1.n,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: "text.eta, 28/34, 700"
                    }
