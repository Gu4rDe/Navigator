name: UI-kit

children:
  - {
      id: unote.1,
      type: text,
      position: [ 60, 72 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: Токены
    }
  - {
      id: unote.2,
      type: text,
      position: [ 60, 1252 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: Компоненты
    }

  # ═══ Токены ═══
  - id: uikit.tokens
    type: frame
    position: [ 60, 120 ]
    size: [ 1440, 1080 ]
    layout: { type: flex, direction: column, gap: 28, padding: 48 }
    fill: $surface.card
    children:
      - {
          id: ut.title,
          type: text,
          size: [ hug, hug ],
          style: $text.h1,
          content: Дизайн-токены
        }
      - id: ut.colors
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 12 }
        children:
          - {
              id: ut.colors.t,
              type: text,
              size: [ hug, hug ],
              style: $text.subtitle,
              content: Цвета
            }
          - id: ut.swatches
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: grid,
                rows: [ auto, auto, auto, auto ],
                columns: [ 168, 168, 168, 168, 168, 168, 168 ],
                gap: 12
              }
            children:
              - id: sw.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: sw.1.c,
                      type: rect,
                      size: [ fill, 56 ],
                      cornerRadius: $radius.md,
                      fill: $brand.primary
                    }
                  - {
                      id: sw.1.n,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      color: $text.primary,
                      content: brand.primary
                    }
                  - {
                      id: sw.1.h,
                      type: text,
                      size: [ hug, hug ],
                      fontSize: 11,
                      color: $text.secondary,
                      content: "#1677FF"
                    }
              - id: sw.2
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: sw.2.c,
                      type: rect,
                      size: [ fill, 56 ],
                      cornerRadius: $radius.md,
                      fill: $brand.hover
                    }
                  - {
                      id: sw.2.n,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      color: $text.primary,
                      content: brand.hover
                    }
                  - {
                      id: sw.2.h,
                      type: text,
                      size: [ hug, hug ],
                      fontSize: 11,
                      color: $text.secondary,
                      content: "#4096FF"
                    }
              - id: sw.3
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: sw.3.c,
                      type: rect,
                      size: [ fill, 56 ],
                      cornerRadius: $radius.md,
                      fill: $brand.active
                    }
                  - {
                      id: sw.3.n,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      color: $text.primary,
                      content: brand.active
                    }
                  - {
                      id: sw.3.h,
                      type: text,
                      size: [ hug, hug ],
                      fontSize: 11,
                      color: $text.secondary,
                      content: "#0958D9"
                    }
              - id: sw.4
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: sw.4.c,
                      type: rect,
                      size: [ fill, 56 ],
                      cornerRadius: $radius.md,
                      fill: $brand.bg
                    }
                  - {
                      id: sw.4.n,
                      type: text,
                      size: [ hug, hug ],
