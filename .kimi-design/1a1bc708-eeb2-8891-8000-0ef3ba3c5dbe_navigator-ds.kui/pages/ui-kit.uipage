                  - {
                      id: sw.4.h,
                      type: text,
                      size: [ hug, hug ],
                      fontSize: 11,
                      color: $text.secondary,
                      content: "#E6F4FF"
                    }
              - id: sw.5
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: sw.5.c,
                      type: rect,
                      size: [ fill, 56 ],
                      cornerRadius: $radius.md,
                      fill: $text.primary
