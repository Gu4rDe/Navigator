          values: { time: "14:58" }
        }
      - id: sar.hero
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 12,
            padding: [ 36, 24, 8, 24 ],
            alignItems: center
          }
        children:
          - id: sar.check
            type: frame
            size: [ 88, 88 ]
            cornerRadius: $radius.pill
            fill: $status.successBg
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: g.sar.check,
