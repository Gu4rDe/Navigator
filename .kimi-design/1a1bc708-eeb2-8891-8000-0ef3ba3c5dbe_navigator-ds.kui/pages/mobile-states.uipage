                  fill: $status.success
                }
          - {
              id: sar.title,
              type: text,
              size: [ hug, hug ],
              style: $text.h1,
              content: Вы приехали
            }
          - {
              id: sar.sub,
              type: text,
              size: [ hug, hug ],
              style: $text.body,
              color: $text.secondary,
              content: "Тверская ул., 15"
            }
          - id: sar.tags
            type: frame
