          - {
              id: sst.modal.t,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Сбросить локальные данные?
            }
          - {
              id: sst.modal.s,
              type: text,
              size: [ fill, hug ],
              style: $text.body,
              color: $text.secondary,
              content: "Будут удалены история поиска, сохранённые точки и настройки. Действие
                необратимо"
            }
          - id: sst.modal.actions
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8 }
            margin: [ 4, 0, 0, 0 ]
            children:
              - {
                  id: sst.btn.cancel,
                  type: instance,
                  source: button,
                  size: [ fill, 44 ],
                  values: { label: Отмена, kind: secondary }
                }
              - {
                  id: sst.btn.reset,
                  type: instance,
                  source: button,
                  size: [ fill, 44 ],
                  values: { label: Сбросить, kind: danger }
                }

  # ═══ 11s. Статус: REPLAY и ошибки ═══
  - id: state.status
    type: frame
    position: [ 960, 2020 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.s.status,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: sta.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: sta.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.sta.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: sta.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Статус
            }
          - {
              id: sta.tag,
              type: instance,
              source: tag,
              values: { label: REPLAY, tone: replay }
            }
      - id: sta.banner
        type: instance
        source: alert
        size: [ fill, hug ]
        margin: [ 8, 16, 0, 16 ]
        values:
          tone: warning
          title: Воспроизведение записи
          message: "Данные не являются текущими: сценарий ДТП, запись от 12.06"
      - id: sta.health
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: sta.health.t,
              type: text,
              size: [ fill, hug ],
              style: $text.strong,
              margin: [ 16, 16, 4, 16 ],
              content: Потоки данных
            }
          - id: sta.r1
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Маршруты
              subtitle: "replay, кадр 00:12:40"
              control:
                - {
                    id: sta.r1.tag,
                    type: instance,
                    source: tag,
                    values: { label: Replay, tone: replay, dotVisible: false }
                  }
          - {
              id: sta.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: sta.r2
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Пробки
              subtitle: "данные на 14:20, устарели"
              control:
                - {
                    id: sta.r2.tag,
                    type: instance,
                    source: tag,
                    values: { label: Stale, tone: warning, dotVisible: false }
                  }
          - {
              id: sta.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: sta.r3
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: События
              subtitle: "таймаут 2 раза за час"
              control:
                - {
                    id: sta.r3.tag,
                    type: instance,
                    source: tag,
                    values: { label: Ошибки, tone: error, dotVisible: false }
                  }
      - id: sta.errors
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column, gap: 8, padding: 16 }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: sta.errors.t,
              type: text,
              size: [ hug, hug ],
              style: $text.strong,
              content: Ошибки API
            }
          - id: sta.e1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: sta.e1.t,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.strong,
                  fontSize: 13,
                  content: "E_TIMEOUT, GET /v1/events, retryable"
                }
              - {
                  id: sta.e1.s,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.caption,
                  content: "14:31:02, requestId: a41f-92ce"
                }
          - { id: sta.ed, type: rect, size: [ fill, 1 ], fill: $divider.subtle }
          - id: sta.e2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: sta.e2.t,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.strong,
                  fontSize: 13,
                  content: "E_COVERAGE, POST /v1/routes, не retryable"
                }
              - {
                  id: sta.e2.s,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.caption,
                  content: "14:12:47, requestId: 07bd-55e1"
                }
      - {
          id: hi.s.status,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 12s. О программе: offline ═══
  - id: state.about
    type: frame
    position: [ 1410, 2020 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.s.about,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: sab.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: sab.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.sab.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: sab.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: О программе
            }
          - {
              id: sab.tag,
              type: instance,
              source: tag,
              values: { label: OFFLINE, tone: unknown, dotVisible: false }
            }
      - id: sab.hero
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 10,
            padding: [ 16, 24, 8, 24 ],
            alignItems: center
          }
        children:
          - id: sab.icon
            type: frame
            size: [ 72, 72 ]
            cornerRadius: $radius.xl
            fill: $brand.primary
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: g.sab.logo,
                  type: svg,
                  size: [ 32, 32 ],
                  icon: fas:route,
                  fill: $text.inverse
                }
          - {
              id: sab.name,
              type: text,
              size: [ hug, hug ],
              style: $text.title,
              content: Навигатор
            }
          - {
              id: sab.ver,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: "Версия 1.4.2 (104), Compose Multiplatform"
            }
          - {
              id: sab.mode,
              type: instance,
              source: tag,
              values: { label: "Режим данных: DEMO", tone: unknown, dotVisible: false }
            }
      - id: sab.alert
        type: instance
        source: alert
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        values:
          title: Экран работает без сети
          message: "Версия, лицензии и атрибуция встроены в приложение и доступны offline"
      - id: sab.rows
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: sab.r1
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Данные карты
              subtitle: © OpenStreetMap contributors
              control:
                - {
                    id: g.sab.c1,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: sab.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: sab.r2
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Лицензии картографии
              subtitle: "ODbL 1.0, CC BY-SA 2.0"
              control:
                - {
                    id: g.sab.c2,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
      - {
          id: hi.s.about,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }
