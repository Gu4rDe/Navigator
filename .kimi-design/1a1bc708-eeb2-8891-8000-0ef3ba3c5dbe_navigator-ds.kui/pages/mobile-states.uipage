              type: instance,
              source: button,
              size: [ fill, 40 ],
              values: { label: Повторить сценарий, kind: secondary }
            }
      - {
          id: hi.s.arrival,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 9s. Событие: истекло ═══
