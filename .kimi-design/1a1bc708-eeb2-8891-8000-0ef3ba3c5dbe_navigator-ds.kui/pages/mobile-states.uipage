                  source: tag,
                  values: { label: REPLAY, tone: replay }
                }
              - {
                  id: sar.tag.note,
                  type: instance,
                  source: tag,
                  values: { label: учебная поездка, tone: unknown, dotVisible: false }
                }
      - id: sar.stats
        type: frame
        size: [ fill, hug ]
        margin: [ 16, 16, 0, 16 ]
        layout:
          {
            type: grid,
            rows: [ auto, auto ],
            columns: [ 1fr, 1fr ],
            gap: 16,
            padding: 16
          }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: sar.st1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: sar.st1.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: "18,4 км"
                }
              - {
                  id: sar.st1.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: "расстояние, симуляция"
                }
          - id: sar.st2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: sar.st2.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: 31 мин
                }
              - {
                  id: sar.st2.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: "время, симуляция"
                }
      - id: sar.note
        type: instance
        source: alert
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        values:
          {
            title: "Учебная поездка",
            message: "Пройдена в симуляции, GNSS не использовался. В статистику не
              включается"
          }
      - { id: sar.spacer, type: frame, size: [ fill, fill ] }
      - id: sar.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 8, 16, 40, 16 ] }
        children:
