              size: [ fill, hug ],
              style: $text.subtitle,
              content: Статус и симуляция
            }
          - {
              id: status.live,
              type: instance,
              source: tag,
              values: { label: LIVE, tone: live }
            }
      - id: status.health
        type: frame
        size: [ fill, hug ]
        margin: [ 8, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: status.health.t,
              type: text,
              size: [ fill, hug ],
              style: $text.strong,
              margin: [ 16, 16, 4, 16 ],
              content: Потоки данных
            }
          - id: status.row.routes
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Маршруты
              subtitle: "обновлено 14:32:10, 12 с назад"
              control:
                - {
                    id: status.tag.routes,
                    type: instance,
                    source: tag,
                    values: { label: OK, tone: success, dotVisible: false }
                  }
          - {
              id: status.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: status.row.traffic
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Пробки
              subtitle: "обновлено 14:31:58, 24 с назад"
              control:
                - {
                    id: status.tag.traffic,
                    type: instance,
                    source: tag,
                    values: { label: OK, tone: success, dotVisible: false }
                  }
          - {
              id: status.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: status.row.events
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: События
              subtitle: "данные на 14:20, задержка потока"
              control:
                - {
                    id: status.tag.events,
                    type: instance,
                    source: tag,
                    values: { label: Stale, tone: warning, dotVisible: false }
                  }
      - id: status.coverage
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column, gap: 8, padding: 16 }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: status.coverage.row
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                justifyContent: spaceBetween,
                alignItems: center
              }
            children:
              - {
                  id: status.coverage.t,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.strong,
                  content: Покрытие картой
                }
              - {
                  id: status.coverage.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.strong,
                  content: "82%"
                }
          - id: status.coverage.bar
            type: frame
            size: [ fill, 6 ]
            cornerRadius: $radius.pill
            fill: $divider.subtle
            children:
              - {
                  id: status.coverage.fill,
                  type: rect,
                  position: [ 0, 0 ],
                  size: [ 268, 6 ],
                  cornerRadius: $radius.pill,
                  fill: $brand.primary
                }
          - {
              id: status.coverage.s,
              type: text,
              size: [ fill, hug ],
              style: $text.caption,
              content: "Районы Север и Восток без данных показаны серым, а не зелёным"
            }
      - id: status.errors
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: row, gap: 10, padding: 16, alignItems: center }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: g.st.ok,
              type: svg,
              size: [ 18, 18 ],
              icon: fas:circle-check,
              fill: $status.success
            }
          - id: status.errors.texts
            type: frame
            size: [ 280, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: status.errors.t,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.strong,
                  content: Ошибок нет
                }
              - {
                  id: status.errors.s,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.caption,
                  content: "За последний час, API отвечает стабильно"
                }
      - id: status.sim
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column, gap: 12, padding: 16 }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: status.sim.t,
              type: text,
              size: [ hug, hug ],
              style: $text.strong,
              content: Панель симуляции
            }
          - id: status.sim.controls
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 12, alignItems: center }
            children:
              - id: sim.play
                type: instance
                source: icon-button
                size: [ 44, 44 ]
                values:
                  kind: primary
                  glyph:
                    - {
                        id: g.sim.play,
                        type: svg,
                        size: [ 16, 16 ],
                        icon: fas:play,
                        fill: $text.inverse
                      }
              - id: sim.pause
                type: instance
                source: icon-button
                size: [ 44, 44 ]
                overrides:
                  ib.root: { fill: $surface.base, effects: null }
                values:
                  glyph:
                    - {
                        id: g.sim.pause,
                        type: svg,
                        size: [ 16, 16 ],
                        icon: fas:pause,
                        fill: $text.secondary
                      }
              - id: sim.speed
                type: instance
                source: segmented
                values: { label1: "1×", label2: "2×", label3: "4×" }
          - id: status.sim.seek
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 6 }
            children:
              - id: status.sim.seekbar
                type: frame
                size: [ fill, 6 ]
                cornerRadius: $radius.pill
                fill: $divider.subtle
                children:
                  - {
                      id: status.sim.seekfill,
                      type: rect,
                      position: [ 0, 0 ],
                      size: [ 130, 6 ],
                      cornerRadius: $radius.pill,
                      fill: $brand.primary
                    }
              - {
                  id: status.sim.time,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: "00:12:40 / 00:31:00"
                }
          - id: status.sim.triggers
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8, wrap: true }
            children:
              - {
                  id: sim.trig.offroute,
                  type: instance,
                  source: button,
                  values: { label: Off-route, kind: secondary }
                }
              - {
                  id: sim.trig.stale,
                  type: instance,
                  source: button,
                  values: { label: Stale, kind: secondary }
                }
              - {
                  id: sim.trig.crash,
                  type: instance,
                  source: button,
                  values: { label: ДТП, kind: secondary }
                }
              - {
                  id: sim.trig.offline,
                  type: instance,
                  source: button,
                  values: { label: Offline, kind: secondary }
                }
              - {
                  id: sim.trig.arrive,
                  type: instance,
                  source: button,
                  values: { label: Прибытие, kind: secondary }
                }
              - {
                  id: sim.trig.nocov,
                  type: instance,
                  source: button,
                  values: { label: Нет покрытия, kind: secondary }
                }
      - {
          id: hi.status,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 12. О программе ═══
  - id: screen.about
    type: frame
    position: [ 1410, 2020 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.about,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: about.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: about.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.about.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: about.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: О программе
            }
      - id: about.hero
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 10,
            padding: [ 16, 24, 8, 24 ],
            alignItems: center
          }
        children:
          - id: about.icon
            type: frame
            size: [ 72, 72 ]
            cornerRadius: $radius.xl
            fill: $brand.primary
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: g.about.logo,
                  type: svg,
                  size: [ 32, 32 ],
                  icon: fas:route,
                  fill: $text.inverse
                }
          - {
              id: about.name,
              type: text,
              size: [ hug, hug ],
              style: $text.title,
              content: Навигатор
            }
          - {
              id: about.ver,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: "Версия 1.4.2 (104), Compose Multiplatform"
            }
          - {
              id: about.mode,
              type: instance,
              source: tag,
              values: { label: "Режим данных: LIVE", tone: live, dotVisible: false }
            }
      - id: about.rows
        type: frame
        size: [ fill, hug ]
        margin: [ 16, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: about.r1
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Данные карты
              subtitle: © OpenStreetMap contributors
              control:
                - {
                    id: g.ab1,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: about.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: about.r2
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Лицензии картографии
              subtitle: "ODbL 1.0, CC BY-SA 2.0"
              control:
                - {
                    id: g.ab2,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: about.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: about.r3
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Правовая информация
              subtitle: Условия использования и приватность
              control:
                - {
                    id: g.ab3,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
      - id: about.offline
        type: instance
        source: alert
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        values:
          {
            title: "Работает без сети",
            message: "Экран доступен полностью offline, все тексты встроены в приложение"
          }
      - { id: about.spacer, type: frame, size: [ fill, fill ] }
      - {
          id: about.copy,
          type: text,
          size: [ fill, hug ],
          margin: [ 0, 24, 0, 24 ],
          style: $text.caption,
          align: [ center, top ],
          content: "© 2025 Навигатор"
        }
      - {
          id: hi.about,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

prototype: |
  flow main = "screen.welcome" {
    viewport: [390, 844]
  }

  on click("button.allow") { navigate("screen.map", transition: slide("left", 300)) }
  on click("button.skip") { navigate("screen.map", transition: slide("left", 300)) }

  on click("search.bar") { navigate("screen.search") }
  on click("fab.route") { navigate("screen.build", transition: slide("up", 300)) }
  on click("button.events") { navigate("screen.event") }
  on click("button.status") { navigate("screen.status") }
  on click("button.settings") { navigate("screen.settings") }
  on click("button.about") { navigate("screen.about") }

  on click("search.back") { back() }
  on click("result.1") { navigate("screen.point", transition: slide("left", 300)) }
  on click("result.2") { navigate("screen.point", transition: slide("left", 300)) }
  on click("result.3") { navigate("screen.point", transition: slide("left", 300)) }

  on click("point.back") { back() }
  on click("button.here") { navigate("screen.build", transition: slide("left", 300)) }
  on click("button.from") { navigate("screen.build", transition: slide("left", 300)) }
  on click("button.recalc") { navigate("screen.preview", transition: slide("left", 300)) }

  on click("build.back") { back() }
  on click("button.build") { navigate("screen.preview", transition: slide("left", 300)) }

  on click("preview.back") { back() }
  on click("button.start") { navigate("screen.guidance", transition: slide("left", 300)) }
  on click("button.sim") { navigate("screen.guidance", transition: slide("left", 300)) }

  on click("button.finish") { navigate("screen.arrival", transition: dissolve(200)) }

  on click("button.tomap") { navigate("screen.map") }
  on click("button.reverse") { navigate("screen.build", transition: slide("left", 300)) }

  on click("event.back") { back() }
  on click("button.showmap2") { back() }
  on click("settings.back") { back() }
  on click("status.back") { back() }
  on click("about.back") { back() }
