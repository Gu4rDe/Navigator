name: Экраны mobile

children:
  # ── примечания к фреймам ──
  - {
      id: note.1,
      type: text,
      position: [ 60, 72 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 1. Запуск
    }
  - {
      id: note.2,
      type: text,
      position: [ 510, 72 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 2. Карта
    }
  - {
      id: note.3,
      type: text,
      position: [ 960, 72 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 3. Поиск
    }
  - {
      id: note.4,
      type: text,
      position: [ 1410, 72 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 4. Точка
    }
  - {
      id: note.5,
      type: text,
      position: [ 60, 1022 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 5. Построение
    }
  - {
      id: note.6,
      type: text,
      position: [ 510, 1022 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 6. Варианты
    }
  - {
      id: note.7,
      type: text,
      position: [ 960, 1022 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 7. Ведение
    }
  - {
      id: note.8,
      type: text,
      position: [ 1410, 1022 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 8. Прибытие
    }
  - {
      id: note.9,
      type: text,
      position: [ 60, 1972 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 9. Событие
    }
  - {
      id: note.10,
      type: text,
      position: [ 510, 1972 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 10. Настройки
    }
  - {
      id: note.11,
      type: text,
      position: [ 960, 1972 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 11. Статус
    }
  - {
      id: note.12,
      type: text,
      position: [ 1410, 1972 ],
      size: [ hug, hug ],
      fontSize: 32,
      fontWeight: 700,
      color: "#000000",
      content: 12. О программе
    }

  # ═══ 1. Первый запуск ═══
  - id: screen.welcome
    type: frame
    position: [ 60, 120 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.welcome,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: welcome.hero
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 12,
            padding: [ 24, 24, 8, 24 ],
            alignItems: center
          }
        children:
          - id: welcome.icon
            type: frame
            size: [ 88, 88 ]
            cornerRadius: $radius.pill
            fill: $brand.bg
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: welcome.icon.glyph,
                  type: svg,
                  size: [ 36, 36 ],
                  icon: fas:route,
                  fill: $brand.primary
                }
          - {
              id: welcome.title,
              type: text,
              size: [ hug, hug ],
              style: $text.h1,
              content: Навигатор
            }
          - id: welcome.sub
            type: text
            size: [ fill, hug ]
            style: $text.body
            color: $text.secondary
            align: [ center, top ]
            content: Маршруты, пробки и события на дороге
      - id: welcome.card
        type: frame
        size: [ fill, hug ]
        margin: [ 20, 16, 0, 16 ]
        layout: { type: flex, direction: column, padding: [ 16, 16, 8, 16 ], gap: 4 }
        fill: $surface.card
        stroke: $stroke.hairline
        cornerRadius: $radius.lg
        children:
          - {
              id: welcome.card.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Геолокация
            }
          - {
              id: welcome.card.sub,
              type: text,
              size: [ fill, hug ],
              style: $text.caption,
              content: "Для позиции на карте, ведения и пересчёта"
            }
          - id: welcome.opt.exact
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                padding: [ 10, 0 ],
                alignItems: center
              }
            children:
              - id: welcome.radio.exact
                type: frame
                size: [ 22, 22 ]
                cornerRadius: $radius.pill
                stroke: { color: $brand.primary, width: 2, alignment: inside }
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: welcome.radio.exact.dot,
                      type: ellipse,
                      size: [ 12, 12 ],
                      fill: $brand.primary
                    }
              - id: welcome.opt.exact.texts
                type: frame
                size: [ 240, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: welcome.opt.exact.t,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.strong,
                      content: Точная геолокация
                    }
                  - {
                      id: welcome.opt.exact.s,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.caption,
                      content: Ведение и голосовые подсказки
                    }
          - id: welcome.opt.approx
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                padding: [ 10, 0 ],
                alignItems: center
              }
            children:
              - {
                  id: welcome.radio.approx,
                  type: ellipse,
                  size: [ 22, 22 ],
                  stroke: { color: $border.default, width: 2, alignment: inside }
                }
              - id: welcome.opt.approx.texts
                type: frame
                size: [ 240, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: welcome.opt.approx.t,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.strong,
                      content: Приблизительная
                    }
                  - {
                      id: welcome.opt.approx.s,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.caption,
                      content: "Позиция с погрешностью до 500 м"
                    }
          - id: welcome.opt.none
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                padding: [ 10, 0 ],
                alignItems: center
              }
            children:
              - {
                  id: welcome.radio.none,
                  type: ellipse,
                  size: [ 22, 22 ],
                  stroke: { color: $border.default, width: 2, alignment: inside }
                }
              - id: welcome.opt.none.texts
                type: frame
                size: [ 240, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: welcome.opt.none.t,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.strong,
                      content: Без геолокации
                    }
                  - {
                      id: welcome.opt.none.s,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.caption,
                      content: Ручной выбор точки старта
                    }
      - id: welcome.privacy
        type: text
        size: [ fill, hug ]
        margin: [ 12, 24, 0, 24 ]
        style: $text.caption
        align: [ center, top ]
        content: Позиция обрабатывается на устройстве
      - { id: welcome.spacer, type: frame, size: [ fill, fill ] }
      - id: welcome.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 8, 16, 40, 16 ] }
        children:
          - id: button.allow
            type: instance
            source: button
            size: [ fill, 48 ]
            values: { label: Разрешить геолокацию, size: lg }
          - id: button.skip
            type: instance
            source: button
            size: [ fill, 40 ]
            values: { label: Продолжить без геолокации, kind: ghost }
      - {
          id: hi.welcome,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 2. Основная карта ═══
  - id: screen.map
    type: frame
    position: [ 510, 120 ]
    size: [ 390, 844 ]
    layout: { type: free, overflow: hidden }
    fill: $map.canvas
    children:
      - id: map.base
        type: instance
        source: map-base
        size: [ 390, 844 ]
        position: [ 0, 0 ]
        values:
          overlays:
            - id: ov.route
              type: path
              position: [ 0, 0 ]
              size: [ 390, 844 ]
              viewBox: [ 390, 844 ]
              path: M198 844 L198 560 Q198 528 230 528 L318 528
              stroke: { color: $brand.primary, width: 8, cap: round }
            - id: ov.jam.warn
              type: path
              position: [ 0, 0 ]
              size: [ 390, 844 ]
              viewBox: [ 390, 844 ]
              path: M198 756 L198 656
              stroke: { color: $status.warning, width: 8, cap: round }
            - id: ov.jam.err
              type: path
              position: [ 0, 0 ]
              size: [ 390, 844 ]
              viewBox: [ 390, 844 ]
              path: M198 844 L198 768
              stroke: { color: $status.error, width: 8, cap: round }
            - {
                id: ov.accuracy,
                type: ellipse,
                position: [ 166, 668 ],
                size: [ 64, 64 ],
                fill: "#1677FF26"
              }
            - {
                id: ov.position,
                type: ellipse,
                position: [ 187, 689 ],
                size: [ 22, 22 ],
                fill: $brand.primary,
                stroke: { color: $surface.card, width: 3, alignment: inside }
              }
            - {
                id: ov.pin,
                type: svg,
                position: [ 305, 494 ],
                size: [ 26, 34 ],
                icon: fas:location-dot,
                fill: $status.error
              }
            - id: ov.event
              type: frame
              position: [ 242, 316 ]
              size: [ 28, 28 ]
              cornerRadius: $radius.pill
              fill: $status.warning
              stroke: { color: $surface.card, width: 2, alignment: inside }
              layout: { type: flex, alignItems: center, justifyContent: center }
              children:
                - {
                    id: ov.event.icon,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:car-burst,
                    fill: $text.inverse
                  }
      - {
          id: sb.map,
          type: instance,
          source: ios-status-bar,
          position: [ 0, 0 ],
          size: [ 390, 59 ],
          values: { time: "14:32", style: light }
        }
      - id: search.bar
        type: frame
        position: [ 16, 72 ]
        size: [ 358, 48 ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 0, 14 ],
            alignItems: center
          }
        fill: $surface.card
        cornerRadius: $radius.lg
        effects: $shadow.card
        children:
          - {
              id: search.bar.icon,
              type: svg,
              size: [ 18, 18 ],
              icon: fas:magnifying-glass,
              fill: $text.disabled
            }
          - {
              id: search.bar.text,
              type: text,
              size: [ fill, hug ],
              style: $text.body,
              color: $text.disabled,
              content: Куда поедем?
            }
      - {
          id: map.live,
          type: instance,
          source: tag,
          position: [ 16, 132 ],
          values: { label: LIVE, tone: live }
        }
      - {
          id: map.fresh,
          type: text,
          position: [ 88, 136 ],
          size: [ hug, hug ],
          fontSize: 13,
          fontWeight: 600,
          color: "#FFFFFFCC",
          content: данные на 14:32
        }
      - id: button.events
        type: instance
        source: icon-button
        position: [ 330, 200 ]
        size: [ 44, 44 ]
        values:
          badge: true
          glyph:
            - {
                id: g.events,
                type: svg,
                size: [ 20, 20 ],
                icon: fas:triangle-exclamation,
                fill: $text.primary
              }
      - id: button.status
        type: instance
        source: icon-button
        position: [ 330, 256 ]
        size: [ 44, 44 ]
        values:
          glyph:
            - {
                id: g.status,
                type: svg,
                size: [ 20, 20 ],
                icon: fas:signal,
                fill: $text.primary
              }
      - id: button.settings
        type: instance
        source: icon-button
        position: [ 330, 312 ]
        size: [ 44, 44 ]
        values:
          glyph:
            - {
                id: g.settings,
                type: svg,
                size: [ 20, 20 ],
                icon: fas:gear,
                fill: $text.primary
              }
      - id: button.about
        type: instance
        source: icon-button
        position: [ 330, 368 ]
        size: [ 44, 44 ]
        values:
          glyph:
            - {
                id: g.about,
                type: svg,
                size: [ 20, 20 ],
                icon: fas:circle-info,
                fill: $text.primary
              }
      - id: fab.route
        type: instance
        source: icon-button
        position: [ 318, 616 ]
        size: [ 56, 56 ]
        values:
          kind: primary
          size: lg
          glyph:
            - {
                id: g.route,
                type: svg,
                size: [ 22, 22 ],
                icon: fas:route,
                fill: $text.inverse
              }
      - id: map.sheet
        type: frame
        position: [ 0, 696 ]
        size: [ 390, 148 ]
        layout: { type: flex, direction: column, gap: 12, padding: [ 10, 16, 34, 16 ] }
        fill: $surface.card
        cornerRadius: [ 20, 20, 0, 0 ]
        effects: $shadow.overlay
        children:
          - {
              id: map.sheet.grab,
              type: rect,
              size: [ 36, 4 ],
              cornerRadius: $radius.pill,
              fill: $border.default,
              alignSelf: center
            }
          - id: map.sheet.chips
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8 }
            children:
              - id: chip.home
                type: instance
                source: button
                values:
                  label: Домой
                  kind: secondary
                  iconVisible: true
                  icon:
                    - {
                        id: g.chip.home,
                        type: svg,
                        size: [ 14, 14 ],
                        icon: fas:house,
                        fill: $text.secondary
                      }
              - id: chip.work
                type: instance
                source: button
                values:
                  label: На работу
                  kind: secondary
                  iconVisible: true
                  icon:
                    - {
                        id: g.chip.work,
                        type: svg,
                        size: [ 14, 14 ],
                        icon: fas:briefcase,
                        fill: $text.secondary
                      }
              - id: chip.events
                type: instance
                source: button
                values:
                  label: События рядом
                  kind: secondary
                  iconVisible: true
                  icon:
                    - {
                        id: g.chip.events,
                        type: svg,
                        size: [ 14, 14 ],
                        icon: fas:triangle-exclamation,
                        fill: $text.secondary
                      }
          - id: map.sheet.hint
            type: text
            size: [ fill, hug ]
            style: $text.caption
            content: Пробки обновлены 14:32, маршрут до центра 32 мин
      - {
          id: hi.map,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 3. Поиск ═══
  - id: screen.search
    type: frame
    position: [ 960, 120 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.search,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: search.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: search.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.search.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - id: search.input
            type: instance
            source: input
            size: [ fill, 48 ]
            values: { value: Тверская, state: focus }
      - id: search.chips
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: row, gap: 8, padding: [ 4, 16, 8, 16 ] }
        children:
          - id: search.chip.home
            type: instance
            source: button
            values:
              label: Дом
              kind: secondary
              iconVisible: true
              icon:
                - {
                    id: g.sch.home,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:house,
                    fill: $text.secondary
                  }
          - id: search.chip.work
            type: instance
            source: button
            values:
              label: Работа
              kind: secondary
              iconVisible: true
              icon:
                - {
                    id: g.sch.work,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:briefcase,
                    fill: $text.secondary
                  }
          - id: search.chip.recent
            type: instance
            source: button
            values:
              label: Недавние
              kind: secondary
              iconVisible: true
              icon:
                - {
                    id: g.sch.recent,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:clock-rotate-left,
                    fill: $text.secondary
                  }
      - {
          id: search.cap.history,
          type: text,
          size: [ fill, hug ],
          margin: [ 12, 16, 4, 16 ],
          style: $text.caption,
          content: "История, хранится локально"
        }
      - id: search.history
        type: frame
        size: [ fill, hug ]
        margin: [ 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: history.1
            type: instance
            source: list-item
            size: [ fill, hug ]
            values:
              title: Тверская ул., 15
              subtitle: Москва, 2,4 км
              leading:
                - {
                    id: g.h1,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:clock-rotate-left,
                    fill: $status.info
                  }
          - {
              id: search.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: history.2
            type: instance
            source: list-item
            size: [ fill, hug ]
            values:
              title: Парк Горького, главный вход
              subtitle: Москва, 5,1 км
              leading:
                - {
                    id: g.h2,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:clock-rotate-left,
                    fill: $status.info
                  }
      - {
          id: search.cap.results,
          type: text,
          size: [ fill, hug ],
          margin: [ 16, 16, 4, 16 ],
          style: $text.caption,
          content: "Результаты, API обновлено 14:32"
        }
      - id: search.results
        type: frame
        size: [ fill, hug ]
        margin: [ 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: result.1
            type: instance
            source: list-item
            size: [ fill, hug ]
            values:
              title: Тверская улица
              subtitle: Москва, 1,1 км
              leading:
                - {
                    id: g.r1,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:location-dot,
                    fill: $status.info
                  }
              trailing:
                - {
                    id: g.r1t,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: search.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: result.2
            type: instance
            source: list-item
            size: [ fill, hug ]
            values:
              title: Тверская площадь
              subtitle: Москва, 1,4 км
              leading:
                - {
                    id: g.r2,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:location-dot,
                    fill: $status.info
                  }
              trailing:
                - {
                    id: g.r2t,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: search.d3,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: result.3
            type: instance
            source: list-item
            size: [ fill, hug ]
            values:
              title: Тверской бульвар
              subtitle: Москва, 1,8 км
              leading:
                - {
                    id: g.r3,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:location-dot,
                    fill: $status.info
                  }
              trailing:
                - {
                    id: g.r3t,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
      - {
          id: hi.search,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 4. Карточка точки ═══
  - id: screen.point
    type: frame
    position: [ 1410, 120 ]
    size: [ 390, 844 ]
    layout: { type: free, overflow: hidden }
    fill: $map.canvas
    children:
      - id: point.map
        type: instance
        source: map-base
        size: [ 390, 844 ]
        position: [ 0, 0 ]
        values:
          overlays:
            - {
                id: ov.p.accuracy,
                type: ellipse,
                position: [ 166, 240 ],
                size: [ 64, 64 ],
                fill: "#1677FF26"
              }
            - {
                id: ov.p.position,
                type: ellipse,
                position: [ 187, 261 ],
                size: [ 22, 22 ],
                fill: $brand.primary,
                stroke: { color: $surface.card, width: 3, alignment: inside }
              }
            - {
                id: ov.p.pin,
                type: svg,
                position: [ 182, 330 ],
                size: [ 30, 40 ],
                icon: fas:location-dot,
                fill: $status.error
              }
      - {
          id: sb.point,
          type: instance,
          source: ios-status-bar,
          position: [ 0, 0 ],
          size: [ 390, 59 ],
          values: { time: "14:32", style: light }
        }
      - id: point.back
        type: instance
        source: icon-button
        position: [ 16, 72 ]
        size: [ 44, 44 ]
        values:
          glyph:
            - {
                id: g.point.back,
                type: svg,
                size: [ 18, 18 ],
                icon: fas:arrow-left,
                fill: $text.primary
              }
      - {
          id: point.live,
          type: instance,
          source: tag,
          position: [ 330, 80 ],
          values: { label: LIVE, tone: live }
        }
      - id: point.sheet
        type: frame
        position: [ 0, 410 ]
        size: [ 390, 434 ]
        layout: { type: flex, direction: column, gap: 12, padding: [ 10, 16, 34, 16 ] }
        fill: $surface.card
        cornerRadius: [ 20, 20, 0, 0 ]
        effects: $shadow.overlay
        children:
          - {
              id: point.grab,
              type: rect,
              size: [ 36, 4 ],
              cornerRadius: $radius.pill,
              fill: $border.default,
              alignSelf: center
            }
          - id: point.head
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: point.title,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.title,
                  content: "Тверская ул., 15"
                }
              - {
                  id: point.coords,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.caption,
                  content: "55.7602, 37.6185, reverse-geocoding, обновлено 14:32"
                }
          - id: point.tags
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8 }
            children:
              - {
                  id: point.tag.live,
                  type: instance,
                  source: tag,
                  values: { label: LIVE, tone: live }
                }
              - {
                  id: point.tag.event,
                  type: instance,
                  source: tag,
                  values: { label: "ДТП в 400 м", tone: warning }
                }
              - {
                  id: point.tag.save,
                  type: instance,
                  source: tag,
                  values: { label: Не сохранено, tone: unknown, dotVisible: false }
                }
          - id: point.nearby
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 10,
                padding: [ 10, 12 ],
                alignItems: center
              }
            fill: $status.warningBg
            cornerRadius: $radius.md
            children:
              - {
                  id: point.nearby.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:car-burst,
                  fill: $status.warning
                }
              - id: point.nearby.texts
                type: frame
                size: [ 290, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: point.nearby.t,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.strong,
                      fontSize: 14,
                      content: "ДТП, занята правая полоса"
                    }
                  - {
                      id: point.nearby.s,
                      type: text,
                      size: [ fill, hug ],
                      style: $text.caption,
                      content: "Действует до 15:30, достоверность 87%"
                    }
          - id: button.here
            type: instance
            source: button
            size: [ fill, 48 ]
            values:
              label: Сюда
              size: lg
              iconVisible: true
              icon:
                - {
                    id: g.here,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:location-arrow,
                    fill: $text.inverse
                  }
          - id: point.grid
            type: frame
            size: [ fill, hug ]
            layout: { type: grid, rows: [ 40, 40 ], columns: [ 1fr, 1fr ], gap: 8 }
            children:
              - id: button.from
                type: instance
                source: button
                size: [ fill, fill ]
                values: { label: Отсюда, kind: secondary }
              - id: button.save
                type: instance
                source: button
                size: [ fill, fill ]
                values: { label: Сохранить, kind: secondary }
              - id: button.showmap
                type: instance
                source: button
                size: [ fill, fill ]
                values: { label: На карте, kind: secondary }
              - id: button.recalc
                type: instance
                source: button
                size: [ fill, fill ]
                values: { label: Пересчитать, kind: secondary }
      - {
          id: hi.point,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 5. Построение маршрута ═══
  - id: screen.build
    type: frame
    position: [ 60, 1070 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.build,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: build.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: build.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.build.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: build.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Маршрут
            }
          - {
              id: build.live,
              type: instance,
              source: tag,
              values: { label: LIVE, tone: live }
            }
      - id: build.route
        type: frame
        size: [ fill, hug ]
        margin: [ 8, 16, 0, 16 ]
        layout: { type: flex, direction: column, padding: 4 }
        fill: $surface.card
        stroke: $stroke.hairline
        cornerRadius: $radius.lg
        children:
          - id: build.from
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                padding: [ 12, 16 ],
                alignItems: center
              }
            children:
              - {
                  id: build.from.dot,
                  type: ellipse,
                  size: [ 12, 12 ],
                  fill: $status.success
                }
              - id: build.from.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: build.from.cap,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: Откуда
                    }
                  - {
                      id: build.from.val,
                      type: text,
                      size: [ 240, hug ],
                      style: $text.strong,
                      content: Текущая позиция
                    }
          - {
              id: build.div,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: build.to
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                padding: [ 12, 16 ],
                alignItems: center
              }
            children:
              - {
                  id: build.to.dot,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:location-dot,
                  fill: $status.error
                }
              - id: build.to.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: build.to.cap,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: Куда
                    }
                  - {
                      id: build.to.val,
                      type: text,
                      size: [ 240, hug ],
                      style: $text.strong,
                      content: "Тверская ул., 15"
                    }
          - id: build.swap
            type: instance
            source: icon-button
            position: [ 300, 40 ]
            size: [ 40, 40 ]
            overrides:
              ib.root: { size: [ 40, 40 ], stroke: $stroke.hairline, effects: null }
            values:
              glyph:
                - {
                    id: g.swap,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:arrow-right-arrow-left,
                    rotation: 90,
                    fill: $brand.primary
                  }
      - id: build.options
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: build.opt.tolls
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Избегать платных
              subtitle: Платные участки и туннели
              control:
                - { id: sw.tolls, type: instance, source: switch }
          - {
              id: build.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: build.opt.jams
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Избегать пробок
              subtitle: Пересчёт по LIVE-трафику
              control:
                - { id: sw.jams, type: instance, source: switch, values: { state: on } }
          - {
              id: build.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: build.opt.unknown
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Исключить дороги без данных
              subtitle: Участки с покрытием unknown
              control:
                - { id: sw.unknown, type: instance, source: switch, values: { state: on } }
      - id: build.transport
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: row, gap: 12, alignItems: center }
        children:
          - {
              id: build.transport.cap,
              type: text,
              size: [ fill, hug ],
              style: $text.caption,
              content: Транспорт
            }
          - id: build.transport.seg
            type: instance
            source: segmented
            values: { label1: Авто, label2: Пешком, label3: Вело }
      - id: build.depart
        type: instance
        source: setting-row
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        values:
          title: Отправление
          subtitle: Сейчас, 14:32
          control:
            - {
                id: g.depart,
                type: svg,
                size: [ 14, 14 ],
                icon: fas:chevron-right,
                fill: $text.disabled
              }
        overrides:
          row.root: { cornerRadius: $radius.lg }
      - id: build.study
        type: instance
        source: setting-row
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        values:
          title: Учебный сценарий
          subtitle: Симуляция без GNSS, будет помечена
          control:
            - { id: sw.study, type: instance, source: switch }
        overrides:
          row.root: { cornerRadius: $radius.lg }
      - { id: build.spacer, type: frame, size: [ fill, fill ] }
      - id: build.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, padding: [ 8, 16, 40, 16 ] }
        children:
          - id: button.build
            type: instance
            source: button
            size: [ fill, 48 ]
            values: { label: Построить маршрут, size: lg }
      - {
          id: hi.build,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 6. Предпросмотр маршрута ═══
