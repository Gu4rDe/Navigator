              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 10 ]
            }
          - id: guidance.zoom.out
            type: frame
            size: [ fill, 44 ]
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: guidance.zoom.minus,
                  type: text,
                  size: [ hug, hug ],
                  fontSize: 20,
                  fontWeight: 600,
                  color: $text.secondary,
                  content: "−"
                }
      - id: guidance.sheet
        type: frame
        position: [ 0, 560 ]
        size: [ 390, 284 ]
        layout: { type: flex, direction: column, gap: 12, padding: [ 10, 16, 34, 16 ] }
        fill: $surface.card
        cornerRadius: [ 20, 20, 0, 0 ]
        effects: $shadow.overlay
        children:
          - {
              id: guidance.grab,
              type: rect,
              size: [ 36, 4 ],
              cornerRadius: $radius.pill,
              fill: $border.default,
              alignSelf: center
            }
          - id: guidance.eta
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, justifyContent: spaceBetween }
            children:
              - id: guidance.eta.col1
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column }
                children:
                  - {
                      id: guidance.eta.time,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.eta,
                      content: "14:58"
                    }
                  - {
                      id: guidance.eta.cap,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: прибытие
                    }
              - id: guidance.eta.col2
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, alignItems: center }
                children:
                  - {
                      id: guidance.eta.left,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.title,
                      content: 26 мин
                    }
                  - {
                      id: guidance.eta.leftcap,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: осталось
                    }
              - id: guidance.eta.col3
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, alignItems: end }
                children:
                  - {
                      id: guidance.eta.km,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.title,
                      content: "12,4 км"
                    }
                  - {
                      id: guidance.eta.kmcap,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.caption,
                      content: впереди
                    }
          - id: guidance.progress
            type: frame
            size: [ fill, 6 ]
            cornerRadius: $radius.pill
            fill: $divider.subtle
            children:
              - {
                  id: guidance.progress.fill,
                  type: rect,
                  position: [ 0, 0 ],
                  size: [ 128, 6 ],
                  cornerRadius: $radius.pill,
                  fill: $brand.primary
                }
          - id: guidance.next
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 6 }
            children:
              - {
                  id: guidance.next.cap,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: Далее
                }
              - id: guidance.next.1
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: row, gap: 8, alignItems: center }
                children:
                  - {
                      id: g.n1,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:arrow-left,
                      fill: $text.secondary
                    }
                  - {
                      id: guidance.next.1.t,
                      type: text,
                      size: [ 300, hug ],
                      style: $text.caption,
                      color: $text.primary,
                      content: "Через 1,2 км, налево на ул. Тверская"
                    }
              - id: guidance.next.2
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: row, gap: 8, alignItems: center }
                children:
                  - {
                      id: g.n2,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:flag-checkered,
                      fill: $text.secondary
                    }
                  - {
                      id: guidance.next.2.t,
                      type: text,
                      size: [ 300, hug ],
                      style: $text.caption,
                      color: $text.primary,
                      content: "Через 3,8 км, прибытие справа"
                    }
          - id: button.finish
            type: instance
            source: button
            size: [ fill, 40 ]
            values: { label: Завершить маршрут, kind: secondary }
      - {
          id: hi.guidance,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 8. Прибытие ═══
  - id: screen.arrival
    type: frame
    position: [ 1410, 1070 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.arrival,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:58" }
        }
      - id: arrival.hero
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 12,
            padding: [ 36, 24, 8, 24 ],
            alignItems: center
          }
        children:
          - id: arrival.check
            type: frame
            size: [ 88, 88 ]
            cornerRadius: $radius.pill
            fill: $status.successBg
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: g.check,
                  type: svg,
                  size: [ 40, 40 ],
                  icon: fas:check,
                  fill: $status.success
                }
          - {
              id: arrival.title,
              type: text,
              size: [ hug, hug ],
              style: $text.h1,
              content: Вы приехали
            }
          - {
              id: arrival.sub,
              type: text,
              size: [ hug, hug ],
              style: $text.body,
              color: $text.secondary,
              content: "Тверская ул., 15, прибытие 14:58"
            }
          - {
              id: arrival.live,
              type: instance,
              source: tag,
              values: { label: "LIVE, обновления остановлены", tone: live }
            }
      - id: arrival.stats
        type: frame
        size: [ fill, hug ]
        margin: [ 16, 16, 0, 16 ]
        layout:
          {
            type: grid,
            rows: [ auto, auto ],
            columns: [ 1fr, 1fr ],
            gap: 16,
            padding: 16
          }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: arrival.st1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: arrival.st1.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: "18,4 км"
                }
              - {
                  id: arrival.st1.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: расстояние
                }
          - id: arrival.st2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: arrival.st2.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: 31 мин
                }
              - {
                  id: arrival.st2.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: время в пути
                }
          - id: arrival.st3
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: arrival.st3.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: 36 км/ч
                }
              - {
                  id: arrival.st3.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: средняя скорость
                }
          - id: arrival.st4
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: arrival.st4.v,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  color: $status.warning,
                  content: +3 мин
                }
              - {
                  id: arrival.st4.l,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.caption,
                  content: отклонение от плана
                }
      - { id: arrival.spacer, type: frame, size: [ fill, fill ] }
      - id: arrival.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 8, 16, 40, 16 ] }
        children:
          - id: button.tomap
            type: instance
            source: button
            size: [ fill, 48 ]
            values: { label: Вернуться на карту, size: lg }
          - id: button.reverse
            type: instance
            source: button
            size: [ fill, 40 ]
            values: { label: Обратный маршрут, kind: secondary }
          - id: button.rate
            type: instance
            source: button
            size: [ fill, 40 ]
            values: { label: Оценить поездку, kind: ghost }
      - {
          id: hi.arrival,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 9. Событие ИТС ═══
  - id: screen.event
    type: frame
    position: [ 60, 2020 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.event,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: event.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: event.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.event.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: event.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Событие ИТС
            }
          - {
              id: event.tag.live,
              type: instance,
              source: tag,
              values: { label: Активно, tone: success }
            }
      - id: event.hero
        type: frame
        size: [ fill, hug ]
        margin: [ 8, 16, 0, 16 ]
        layout: { type: flex, direction: row, gap: 14, padding: 16, alignItems: center }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: event.icon
            type: frame
            size: [ 52, 52 ]
            cornerRadius: $radius.md
            fill: $status.errorBg
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: g.event.car,
                  type: svg,
                  size: [ 24, 24 ],
                  icon: fas:car-burst,
                  fill: $status.error
                }
          - id: event.hero.texts
            type: frame
            size: [ 150, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - {
                  id: event.hero.t,
                  type: text,
                  size: [ hug, hug ],
                  style: $text.title,
                  content: ДТП
                }
              - {
                  id: event.hero.s,
                  type: text,
                  size: [ fill, hug ],
                  style: $text.caption,
                  content: "Тверская ул., 300 м впереди по маршруту"
                }
          - {
              id: event.tag.sev,
              type: instance,
              source: tag,
              values: { label: Серьёзное, tone: error, dotVisible: false }
            }
      - id: event.meta
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: event.m1
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Срок действия
              subtitle: "с 14:10 до 15:30, истекает через 58 мин"
              control:
                - {
                    id: g.em1,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:clock,
                    fill: $text.disabled
                  }
          - {
              id: event.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: event.m2
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Обновлено
              subtitle: "14:32, источник ИТС, поток LIVE"
              control:
                - {
                    id: event.m2.tag,
                    type: instance,
                    source: tag,
                    values: { label: LIVE, tone: live }
                  }
          - {
              id: event.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: event.m3
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 8, padding: [ 13, 16 ] }
            children:
              - id: event.m3.row
                type: frame
                size: [ fill, hug ]
                layout:
                  {
                    type: flex,
                    direction: row,
                    justifyContent: spaceBetween,
                    alignItems: center
                  }
                children:
                  - {
                      id: event.m3.t,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.body,
                      content: Достоверность
                    }
                  - {
                      id: event.m3.v,
                      type: text,
                      size: [ hug, hug ],
                      style: $text.strong,
                      content: "87%"
                    }
              - id: event.m3.bar
                type: frame
                size: [ fill, 6 ]
                cornerRadius: $radius.pill
                fill: $divider.subtle
                children:
                  - {
                      id: event.m3.fill,
                      type: rect,
                      position: [ 0, 0 ],
                      size: [ 284, 6 ],
                      cornerRadius: $radius.pill,
                      fill: $status.success
                    }
      - id: event.desc
        type: frame
        size: [ fill, hug ]
        margin: [ 12, 16, 0, 16 ]
        layout: { type: flex, direction: column, gap: 6, padding: 16 }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - {
              id: event.desc.cap,
              type: text,
              size: [ hug, hug ],
              style: $text.caption,
              content: Описание
            }
          - {
              id: event.desc.t,
              type: text,
              size: [ fill, hug ],
              style: $text.body,
              content: "Столкновение двух автомобилей, занята правая полоса. Объезд по левой
                полосе, скорость потока 12 км/ч."
            }
      - { id: event.spacer, type: frame, size: [ fill, fill ] }
      - id: event.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 8, 16, 40, 16 ] }
        children:
          - id: button.recalc2
            type: instance
            source: button
            size: [ fill, 48 ]
            values: { label: Пересчитать маршрут, size: lg }
          - id: button.showmap2
            type: instance
            source: button
            size: [ fill, 40 ]
            values: { label: Показать на карте, kind: secondary }
      - {
          id: hi.event,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 10. Настройки ═══
  - id: screen.settings
    type: frame
    position: [ 510, 2020 ]
    size: [ 390, 844 ]
    layout: { type: flex, direction: column, overflow: hidden }
    fill: $surface.base
    children:
      - {
          id: sb.settings,
          type: instance,
          source: ios-status-bar,
          size: [ fill, 59 ],
          values: { time: "14:32" }
        }
      - id: settings.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            padding: [ 8, 16 ],
            alignItems: center
          }
        children:
          - id: settings.back
            type: instance
            source: icon-button
            size: [ 44, 44 ]
            values:
              glyph:
                - {
                    id: g.set.back,
                    type: svg,
                    size: [ 18, 18 ],
                    icon: fas:arrow-left,
                    fill: $text.primary
                  }
          - {
              id: settings.title,
              type: text,
              size: [ fill, hug ],
              style: $text.subtitle,
              content: Настройки
            }
      - {
          id: settings.cap1,
          type: text,
          size: [ fill, hug ],
          margin: [ 8, 16, 4, 16 ],
          style: $text.caption,
          content: Голос и язык
        }
      - id: settings.g1
        type: frame
        size: [ fill, hug ]
        margin: [ 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: set.lang
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Язык
              subtitle: Русский
              control:
                - {
                    id: g.set.lang,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: settings.d1,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: set.voice
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Голос подсказок
              subtitle: Алёна, женский
              control:
                - {
                    id: g.set.voice,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
      - {
          id: settings.cap2,
          type: text,
          size: [ fill, hug ],
          margin: [ 16, 16, 4, 16 ],
          style: $text.caption,
          content: Навигация
        }
      - id: settings.g2
        type: frame
        size: [ fill, hug ]
        margin: [ 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: set.units
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Единицы измерения
              subtitle: Километры
              control:
                - {
                    id: g.set.units,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: settings.d2,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: set.recalc
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Авто-пересчёт маршрута
              subtitle: При сходе или изменении трафика
              control:
                - { id: sw.recalc, type: instance, source: switch, values: { state: on } }
          - {
              id: settings.d3,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: set.threshold
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Порог предупреждений
              subtitle: За 300 м до манёвра
              control:
                - {
                    id: g.set.thr,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
      - {
          id: settings.cap3,
          type: text,
          size: [ fill, hug ],
          margin: [ 16, 16, 4, 16 ],
          style: $text.caption,
          content: Карта и данные
        }
      - id: settings.g3
        type: frame
        size: [ fill, hug ]
        margin: [ 0, 16 ]
        layout: { type: flex, direction: column }
        fill: $surface.card
        cornerRadius: $radius.lg
        children:
          - id: set.mapmode
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Режим карты
              subtitle: Авто, день и ночь
              control:
                - {
                    id: g.set.map,
                    type: svg,
                    size: [ 14, 14 ],
                    icon: fas:chevron-right,
                    fill: $text.disabled
                  }
          - {
              id: settings.d4,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: set.sim
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Режим симуляции
              subtitle: Для Desktop и Web вместо GNSS
              control:
                - { id: sw.sim, type: instance, source: switch }
          - {
              id: settings.d5,
              type: rect,
              size: [ fill, 1 ],
              fill: $divider.subtle,
              margin: [ 0, 16 ]
            }
          - id: row.reset
            type: instance
            source: setting-row
            size: [ fill, hug ]
            values:
              title: Сбросить локальные данные
              subtitle: История, сохранённые точки, DataStore
              control:
                - {
                    id: g.set.trash,
                    type: svg,
                    size: [ 16, 16 ],
                    icon: fas:trash-can,
                    fill: $status.error
                  }
            overrides:
              row.title: { color: $status.error }
      - {
          id: settings.footer,
          type: text,
          size: [ fill, hug ],
          margin: [ 16, 24, 0, 24 ],
          style: $text.caption,
          align: [ center, top ],
          content: "Настройки хранятся локально, DataStore"
        }
      - {
          id: hi.settings,
          type: instance,
          source: ios-home-indicator,
          position: [ 128, 827 ],
          size: [ 134, 5 ]
        }

  # ═══ 11. Статус и симуляция ═══
